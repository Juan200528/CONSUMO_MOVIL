<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeWidth="2dp"
    app:strokeColor="#facc15"
    app:cardBackgroundColor="@android:color/white">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Contenedor con todo el contenido -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Título con margen derecho para no tapar "Promocionada" -->
            <TextView
                android:id="@+id/tvTituloActividadPromocionada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:hint="Título de la actividad"
                android:paddingEnd="160dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Imagen -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="10dp"
                android:clipChildren="true"
                android:clipToPadding="true">

                <ImageView
                    android:id="@+id/ivActividadImagen"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    android:contentDescription="Imagen de actividad"
                    android:src="@drawable/default_image" />
            </LinearLayout>

            <!-- Botón -->
            <Button
                android:id="@+id/btnVerDetallesPromocionada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="36dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#4CAF50"
                android:text="Ver Detalles"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Etiqueta "Promocionada" superpuesta, fija -->
        <TextView
            android:id="@+id/tvPromocionada"
            android:layout_width="149dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:background="@drawable/promocionada_background"
            android:padding="4dp"
            android:text="Promocionada"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:textStyle="bold" />

        <!-- Etiqueta "FINALIZADA" -->
        <TextView
            android:id="@+id/tvFinalizada"
            android:layout_width="149dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/finalizada_background"
            android:padding="4dp"
            android:text="FINALIZADA"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>