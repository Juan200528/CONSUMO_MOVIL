<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeWidth="2dp"
    app:strokeColor="#facc15"
    app:cardBackgroundColor="@android:color/white"
    android:layout_margin="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Etiqueta FINALIZADA -->
        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_estado_finalizada"
            android:text="FINALIZADA"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Título -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Título de la Actividad"
            android:textStyle="bold"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/tvEstado"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

        <!-- Línea divisoria -->
        <View
            android:id="@+id/viewDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#DDD"
            app:layout_constraintTop_toBottomOf="@id/tvTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <!-- Lugar -->
        <ImageView
            android:id="@+id/ivLugarIcono"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_location"
            app:layout_constraintTop_toBottomOf="@id/viewDivider"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvLugar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Lugar:"
            android:textSize="14sp"
            app:layout_constraintTop_toTopOf="@id/ivLugarIcono"
            app:layout_constraintStart_toEndOf="@id/ivLugarIcono"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="8dp" />

        <!-- Responsable -->
        <ImageView
            android:id="@+id/ivResponsableIcono"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_person"
            app:layout_constraintTop_toBottomOf="@id/ivLugarIcono"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvResponsable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Responsable:"
            android:textSize="14sp"
            app:layout_constraintTop_toTopOf="@id/ivResponsableIcono"
            app:layout_constraintStart_toEndOf="@id/ivResponsableIcono"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="8dp" />

        <!-- Fecha -->
        <ImageView
            android:id="@+id/ivFechaIcono"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_calendar"
            app:layout_constraintTop_toBottomOf="@id/ivResponsableIcono"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Fecha:"
            android:textSize="14sp"
            app:layout_constraintTop_toTopOf="@id/ivFechaIcono"
            app:layout_constraintStart_toEndOf="@id/ivFechaIcono"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="8dp" />

        <!-- Botón Ver detalles -->
        <Button
            android:id="@+id/btnVerDetalles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver detalles"
            android:drawablePadding="8dp"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/botonBorde"
            app:layout_constraintTop_toBottomOf="@id/ivFechaIcono"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>